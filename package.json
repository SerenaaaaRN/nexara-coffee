{
  "name": "nexara",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "client"
    ],
    "catalog": {
      "elysia": "1.4.30",
      "better-auth": "1.5.3",
      "typescript": "5.9.3",
      "@types/node": "26.4.0"
    }
  },
  "devDependencies": {
    "turbo": "2.9.6"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "bun run --cwd client dev",
    "dev:server": "bun run --cwd server dev",
    "build": "bun run build:client",
    "build:client": "bun run --cwd client build",
    "build:api": "bun build server/src/app.ts --target=bun --outfile server/dist/entry.js --minify-syntax --minify-whitespace",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "knip": "turbo run knip",
    "format": "turbo run format"
  }
}
